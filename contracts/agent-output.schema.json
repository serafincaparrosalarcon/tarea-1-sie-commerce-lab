{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Salida estructurada del agente de soporte",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_type", "consulted_data", "proposed_action", "response_draft", "justification", "confidence", "priority", "risks", "final_status"],
  "properties": {
    "case_type": { "type": "string" },
    "consulted_data": { "type": "object" },
    "proposed_action": { "type": "string" },
    "response_draft": { "type": "string" },
    "justification": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "priority": { "type": "string", "enum": ["BAJA", "MEDIA", "ALTA", "CRITICA"] },
    "risks": { "type": "array", "items": { "type": "string" } },
    "final_status": { "type": "string", "enum": ["PENDIENTE_REVISION", "APROBADA", "RECHAZADA", "EJECUTADA_SIMULADA"] }
  }
}
